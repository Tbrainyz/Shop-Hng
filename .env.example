# --- Database (Supabase or Neon — both are Postgres, so either works with no code changes) ---
# Supabase: Project Settings > Database > Connection string ("Transaction" pooler for DATABASE_URL, "Session"/direct for DIRECT_URL)
# Neon: Project > Connection Details (Neon gives one pooled string; you can reuse it for both vars below)
DATABASE_URL=
DIRECT_URL=
# Leave DATABASE_URL empty in dev to use an in-memory product/order store (data resets on restart).

# --- Google sign-in (console.cloud.google.com > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Mailgun (app.mailgun.com > Sending > Domains) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Hng-Shopping <no-reply@yourdomain.com>"

# --- Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks) ---
# Use your TEST keys while developing — they start with pk_test_ / sk_test_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Currency: NGN or USD. Changes checkout + display formatting everywhere (lib/currency.ts). ---
NEXT_PUBLIC_CURRENCY=NGN
